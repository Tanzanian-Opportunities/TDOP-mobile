# Copy this file to .env and adjust the values for your environment.
# Loaded by the Flutter app once the mobile scaffold lands (Phase 5 of the
# business roadmap). Never commit the real .env.

# Base URL of the TDOP backend API
API_BASE_URL=http://localhost:8080/api/v1

# Display name of the app
APP_NAME=TDOP

# Environment flag: development | staging | production
APP_ENV=development